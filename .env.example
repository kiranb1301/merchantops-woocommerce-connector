# --- Option A: static API keys (simplest; used for local dev) ---------------
WOO_STORE_URL=http://localhost:8080
WOO_CONSUMER_KEY=ck_replace_me
WOO_CONSUMER_SECRET=cs_replace_me
# Only for a local dev store over http://localhost. Never enable in production.
ALLOW_INSECURE_LOCAL=1

# --- Option B: credentials saved by the connect flow (encrypted at rest) ----
# Generate a key with:  woo-connector genkey
# MERCHANT_ID=demo-merchant
# CONNECTOR_ENC_KEY=
# CREDENTIAL_STORE_PATH=./data/credentials.json

# --- Resilience tuning (optional) -------------------------------------------
RATE_LIMIT_PER_S=4
RATE_LIMIT_BURST=8
MAX_RETRIES=4

# --- MCP transport: stdio (default) or streamable-http -----------------------
# MCP_TRANSPORT=stdio
LOG_LEVEL=INFO
