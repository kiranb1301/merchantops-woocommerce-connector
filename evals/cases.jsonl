{"id":"failed-orders","question":"Which orders failed?","calls":[{"tool":"search_orders","args":{"status":"failed"}}],"expect":[{"path":"count","equals":5}]}
{"id":"payment-reference","question":"What is the payment reference for order 4 and did it fail?","calls":[{"tool":"get_order","args":{"order_id":4}}],"expect":[{"path":"transaction_id","equals":"pay_TEST0004"},{"path":"status","equals":"failed"}]}
{"id":"find-by-email","question":"Find the order for asha7@example.com","calls":[{"tool":"search_orders","args":{"query":"asha7@"}}],"expect":[{"path":"items.0.id","equals":7}]}
{"id":"pii-masked","question":"Who placed order 2? (email must stay masked)","calls":[{"tool":"get_order","args":{"order_id":2}}],"expect":[{"path":"customer.email","equals":"a***@example.com"},{"path":"customer.name","equals":"Asha K."}]}
{"id":"find-product","question":"Find the Notebook product","calls":[{"tool":"search_products","args":{"query":"Notebook"}}],"expect":[{"path":"items.0.sku","equals":"NOTE-A5"}]}
{"id":"product-by-id","question":"Show product 17","calls":[{"tool":"get_product","args":{"product_id":17}}],"expect":[{"path":"sku","equals":"EBOOK-1"},{"path":"name","equals":"Pune Walks"}]}
{"id":"product-no-match","question":"Find products matching keyboard","calls":[{"tool":"search_products","args":{"query":"keyboard"}}],"expect":[{"path":"count","equals":0}]}
{"id":"pagination","question":"List orders five at a time and return a continuation cursor","calls":[{"tool":"list_orders","args":{"page":1,"per_page":5}}],"expect":[{"path":"count","equals":5},{"path":"next_cursor","not_null":true}]}
{"id":"unknown-order","question":"Show order 9999","calls":[{"tool":"get_order","args":{"order_id":9999}}],"expect_error":"not_found"}
{"id":"unknown-product","question":"Show product 9999","calls":[{"tool":"get_product","args":{"product_id":9999}}],"expect_error":"not_found"}
{"id":"bad-status","question":"Show orders with status 'shipped' (not a real status)","calls":[{"tool":"search_orders","args":{"status":"shipped"}}],"expect_error":"__rejected_before_call__"}
